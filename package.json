    "start": "node server.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check"
  },
  "dependencies": {
    "astro": "^5.18.0",
    "@astrojs/node": "^9.5.0",
    "@astrojs/react": "^4.4.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "leaflet": "1.9.4",
    "lucide-react": "^0.562.0",
    "marked": "^15.0.12",
    "sanitize-html": "^2.17.0",
    "dompurify": "^3.4.10",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.3.1",
    "tailwindcss": "^4.1.18",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/sanitize-html": "^2.13.0",
    "typescript": "~5.8.2",
    "concurrently": "^9.1.0"
  }
