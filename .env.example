# Public: canonical/OG absolute base. Set to the real domain in production.
PUBLIC_SITE_URL=https://www.ichr-international.org

# Public: image/API origin. Leave EMPTY for same-origin (dev proxy + single-origin prod).
PUBLIC_API_URL=
