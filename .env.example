# Database (Neon Postgres on Vercel — use the POOLED connection string)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct (non-pooled) connection. Required by schema.prisma `directUrl` for
# `prisma db push` / `prisma generate`. Same database, without `-pooler`.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Auth (required)
JWT_SECRET="change_me_to_a_long_random_string"

# Seeded admin credentials (used by prisma/seed.mjs to CREATE the admin user).
# Never ship real values here, and never leave these as-is in production —
# the login has no rate limiting, so a guessable password is a full CMS takeover.
ADMIN_USERNAME="change-me"
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# Canonical/OG absolute base — set to your real domain in production
PUBLIC_SITE_URL="https://www.ichr-international.org"

# Vercel Blob (admin image uploads). Auto-set on Vercel when a Blob store is
# connected; only needed locally if you upload images in dev.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional: origin override for the admin client's API calls. Empty = same-origin.
# PUBLIC_API_URL=""
