---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';

export const prerender = true;

const input = 'w-full px-3 py-2.5 rounded border border-slate-200 focus:border-[#1a4a68] focus:outline-none text-base';
---

<BaseLayout
  title="Volunteer With ICHR"
  description="Join our global team of professionals working to protect human rights and provide humanitarian assistance."
>
  <PageHeader
    title="Volunteer With Us"
    subtitle="Join our global team of professionals working to protect human rights and provide humanitarian assistance."
  />

  <Section width="content" spacing="lg" bg="subtle">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-xl font-bold text-slate-800 mb-3">Application Form</h2>
        <p class="text-sm text-slate-600">
          We review applications on a rolling basis and will contact qualified candidates.
        </p>
      </div>

      <form class="bg-white p-8 rounded-lg border border-slate-200 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5" for="v-first">First Name</label>
            <input id="v-first" type="text" class={input} />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5" for="v-last">Last Name</label>
            <input id="v-last" type="text" class={input} />
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5" for="v-email">Email Address</label>
            <input id="v-email" type="email" class={input} />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5" for="v-phone">Phone Number</label>
            <input id="v-phone" type="tel" class={input} />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5" for="v-area">Area of Interest</label>
          <select id="v-area" class={`${input} bg-white`}>
            <option>Select an area...</option>
            <option>Field Operations</option>
            <option>Legal Advocacy</option>
            <option>Documentation &amp; Research</option>
            <option>Communications</option>
            <option>Fundraising</option>
            <option>Remote / Digital Support</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5" for="v-exp">Relevant Experience</label>
          <textarea id="v-exp" rows={4} class={`${input} resize-none`} placeholder="Briefly describe your relevant skills and experience..."></textarea>
        </div>
        <div class="bg-slate-50 p-4 rounded text-sm text-slate-600">
          By submitting this application, you agree to our volunteer code of conduct
          and acknowledge that placement is subject to availability and vetting requirements.
        </div>
        <button type="button" class="w-full bg-[#1a4a68] hover:bg-[#133549] text-white font-medium py-3 rounded transition-colors text-sm flex items-center justify-center gap-2">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
          Submit Application
        </button>
      </form>
    </div>
  </Section>
</BaseLayout>
