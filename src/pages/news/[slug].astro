---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Dateline from '@/components/Dateline.astro';
import CategoryPill from '@/components/CategoryPill.astro';
import { getPostBySlug } from '@/lib/api';
import { renderMarkdown } from '@/lib/markdown';
import { resolveAssetUrl, absoluteUrl } from '@/lib/assets';
import ShareButtons from '@/components/ShareButtons.astro';
import ShareRail from '@/components/ShareRail.astro';
import { ORG, SAME_AS, SITE_URL } from '@/lib/site';

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;

// Drafts/missing → friendly 404 page WITH a 404 status (good for crawlers + users).
if (!post || post.status !== 'published') {
  return Astro.rewrite('/404');
}

const bodyHtml = renderMarkdown(post.body);
const coverAbs = absoluteUrl(post.coverImageUrl);
const canonical = new URL(`/news/${post.slug}`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.title,
  description: post.excerpt,
  image: [coverAbs],
  datePublished: post.date,
  dateModified: post.updatedAt,
  author: { '@type': 'Organization', name: post.authorName || 'ICHR' },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: ORG.name,
    url: SITE_URL,
    logo: { '@type': 'ImageObject', url: ORG.logo },
    sameAs: SAME_AS,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};
---

<BaseLayout
  title={`${post.title} — ICHR`}
  description={post.excerpt}
  canonical={canonical}
  ogType="article"
  ogImage={coverAbs}
  jsonLd={jsonLd}
>
  <article>
    <ShareRail url={canonical} title={post.title} />
    <Section width="content" spacing="sm">
      <a
        href="/news"
        class="inline-flex items-center text-sm font-medium text-[#1a4a68] hover:text-[#2a6a96] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1a4a68] focus-visible:ring-offset-2 rounded"
      >
        <svg class="w-4 h-4 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
        Back to Newsroom
      </a>
    </Section>

    <Section width="prose" spacing="none" class="pt-4">
      <Dateline date={post.date} location={post.location} class="mb-3" />
      <div class="mb-4"><CategoryPill category={post.category} /></div>
      <h1 class="text-3xl md:text-[2.5rem] font-bold text-slate-900 leading-tight mb-6">{post.title}</h1>
      <p class="text-lg md:text-xl text-slate-600 leading-relaxed">{post.excerpt}</p>
      <div class="mt-6 pt-6 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center gap-4">
        {post.authorName && (
          <p class="text-sm text-slate-500">By <span class="font-medium text-slate-700">{post.authorName}</span></p>
        )}
        <ShareButtons url={canonical} title={post.title} label="Share" class="sm:ml-auto" />
      </div>
    </Section>

    {post.coverImageUrl && (
      <Section width="content" spacing="sm">
        <div class="rounded-xl overflow-hidden border border-slate-200 bg-[#1a4a68] flex justify-center">
          <img src={resolveAssetUrl(post.coverImageUrl)} alt={post.title} class="max-h-[640px] w-auto object-contain" />
        </div>
      </Section>
    )}

    <Section width="prose" spacing="default">
      <div class="prose-article" set:html={bodyHtml} />
    </Section>

    {post.gallery?.length > 0 && (
      <Section width="content" spacing="default" bg="subtle">
        <div class="flex items-center gap-3 mb-8">
          <span class="h-px w-10 bg-[color:var(--color-gold)]" aria-hidden="true"></span>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">Gallery</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {post.gallery.map((g, i) => (
            <figure class="bg-white rounded-lg overflow-hidden border border-slate-100 shadow-sm">
              <div class="bg-[#1a4a68]">
                <img src={resolveAssetUrl(g.url)} alt={g.caption ?? `${post.title} — image ${i + 1}`} loading="lazy" class="w-full aspect-[4/5] object-contain" />
              </div>
              {g.caption && <figcaption class="px-4 py-3 text-sm text-slate-500 leading-snug">{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </Section>
    )}

    {post.hashtags?.length > 0 && (
      <Section width="prose" spacing="sm">
        <ul class="flex flex-wrap gap-2" aria-label="Tags">
          {post.hashtags.map((tag) => (
            <li class="text-sm font-medium text-[#1a4a68] bg-[#1a4a68]/10 px-3 py-1 rounded-full">
              #{tag.replace(/^#/, '')}
            </li>
          ))}
        </ul>
      </Section>
    )}

    <Section width="prose" spacing="sm">
      <div class="rounded-xl bg-slate-50 border border-slate-100 p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">
        <div>
          <p class="text-base font-semibold text-slate-800">Share this story</p>
          <p class="text-sm text-slate-500">Help raise awareness — share it with your network.</p>
        </div>
        <ShareButtons url={canonical} title={post.title} label="" />
      </div>
    </Section>
  </article>

  <Section bg="primary" spacing="lg">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Support Our Work</h2>
      <p class="text-white/80 mb-8 leading-relaxed">
        Your contribution enables us to continue protecting human rights and providing
        humanitarian assistance to those in need.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/donate" class="px-8 py-3 bg-white text-[#1a4a68] font-medium rounded hover:bg-slate-100 transition-colors">Make a Donation</a>
        <a href="/volunteer" class="px-8 py-3 border border-white/40 text-white font-medium rounded hover:bg-white/10 transition-colors">Volunteer With Us</a>
      </div>
    </div>
  </Section>
</BaseLayout>
