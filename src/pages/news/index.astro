---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import NewsCard from '@/components/NewsCard.astro';
import Dateline from '@/components/Dateline.astro';
import CategoryPill from '@/components/CategoryPill.astro';
import { getPublishedPosts } from '@/lib/api';
import { resolveAssetUrl } from '@/lib/assets';
import { POST_CATEGORIES, type PostCategory } from '@/types';

// SSR (output: 'server' → on-demand by default).
const url = Astro.url;
const page = Math.max(1, Number(url.searchParams.get('page') ?? '1'));
const categoryParam = url.searchParams.get('category') ?? 'All';
const category = (POST_CATEGORIES.includes(categoryParam as PostCategory) ? categoryParam : 'All') as
  | PostCategory
  | 'All';
const PAGE_SIZE = 9;

const { items, totalPages } = await getPublishedPosts({ page, pageSize: PAGE_SIZE, category });

const showFeatured = page === 1 && category === 'All' && items.length > 0;
const featured = showFeatured ? items[0] : undefined;
const rest = featured ? items.slice(1) : items;

const filters: (PostCategory | 'All')[] = ['All', ...POST_CATEGORIES];
const filterHref = (c: string) => (c === 'All' ? '/news' : `/news?category=${encodeURIComponent(c)}`);
const pageHref = (p: number) => {
  const params = new URLSearchParams();
  if (category !== 'All') params.set('category', category);
  if (p > 1) params.set('page', String(p));
  const qs = params.toString();
  return qs ? `/news?${qs}` : '/news';
};
---

<BaseLayout
  title="Press Releases & Statements — ICHR Newsroom"
  description="Official press releases, statements and field updates from the International Coalition for Human Rights."
  canonical={new URL('/news', Astro.site).href}
>
  <header class="bg-[#1a4a68] text-white py-16 md:py-20 px-6 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm font-medium text-white/60 uppercase tracking-wider mb-4">Newsroom</p>
      <h1 class="text-2xl md:text-[2rem] font-bold mb-3 leading-tight">Press Releases &amp; Statements</h1>
      <p class="text-base md:text-lg text-white/85 leading-relaxed max-w-2xl mx-auto">
        Official communications, field updates, and statements from the International
        Coalition for Human Rights.
      </p>
    </div>
  </header>

  <nav class="border-b border-slate-200 bg-white" aria-label="Filter news by category">
    <div class="max-w-6xl mx-auto px-6 py-4 flex flex-wrap gap-2 justify-center" role="radiogroup">
      {filters.map((c) => (
        <a
          href={filterHref(c)}
          role="radio"
          aria-checked={category === c}
          class:list={[
            'text-sm px-4 py-2 rounded-full border transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1a4a68] focus-visible:ring-offset-2',
            category === c
              ? 'bg-[#1a4a68] text-white border-[#1a4a68]'
              : 'text-slate-600 border-slate-200 hover:border-[#1a4a68]',
          ]}
        >
          {c}
        </a>
      ))}
    </div>
  </nav>

  <Section width="wide" spacing="default" bg="subtle">
    {items.length === 0 ? (
      <div class="text-center py-20">
        <h2 class="text-xl font-semibold text-slate-700 mb-2">No posts yet</h2>
        <p class="text-slate-500">
          {category === 'All'
            ? 'There are no published posts at this time. Please check back soon.'
            : `No posts in “${category}” yet.`}
        </p>
      </div>
    ) : (
      <>
        {featured && (
          <a
            href={`/news/${featured.slug}`}
            class="group grid md:grid-cols-2 gap-8 items-center bg-white rounded-xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 mb-12 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1a4a68] focus-visible:ring-offset-2"
          >
            <div class="relative h-72 md:h-80 overflow-hidden bg-[#1a4a68]">
              <img
                src={resolveAssetUrl(featured.coverImageUrl)}
                alt={featured.title}
                loading="lazy"
                class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105 motion-reduce:transform-none"
              />
            </div>
            <div class="p-8">
              <Dateline date={featured.date} location={featured.location} class="mb-3" />
              <CategoryPill category={featured.category} class="mb-4" />
              <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4 group-hover:text-[#1a4a68] transition-colors line-clamp-3">
                {featured.title}
              </h2>
              <p class="text-slate-600 leading-relaxed line-clamp-3">{featured.excerpt}</p>
            </div>
          </a>
        )}

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {rest.map((post) => <NewsCard post={post} />)}
        </div>

        {totalPages > 1 && (
          <nav class="flex justify-center items-center gap-3 mt-14" aria-label="Pagination">
            {page > 1 && (
              <a href={pageHref(page - 1)} class="px-4 py-2 rounded border border-slate-200 text-sm hover:border-[#1a4a68] transition-colors">
                ← Previous
              </a>
            )}
            <span class="text-sm text-slate-500">Page {page} of {totalPages}</span>
            {page < totalPages && (
              <a href={pageHref(page + 1)} class="px-4 py-2 rounded border border-slate-200 text-sm hover:border-[#1a4a68] transition-colors">
                Next →
              </a>
            )}
          </nav>
        )}
      </>
    )}
  </Section>
</BaseLayout>
