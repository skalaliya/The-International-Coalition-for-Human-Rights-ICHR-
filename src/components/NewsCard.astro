---
import Dateline from '@/components/Dateline.astro';
import CategoryPill from '@/components/CategoryPill.astro';
import { resolveAssetUrl } from '@/lib/assets';
import { useTranslations, localizeHref, type Locale } from '@/i18n';
import type { Post } from '@/types';

interface Props {
  post: Post;
  lang?: Locale;
}
const { post, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const href = localizeHref(`/news/${post.slug}`, lang);
const catLabel = t.categories[post.category] ?? post.category;
---

<a
  href={href}
  aria-label={`${catLabel}: ${post.title}`}
  class="group block bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl border border-slate-100 transition-all duration-300 h-full focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1a4a68] focus-visible:ring-offset-2 motion-reduce:transition-none"
>
  <article class="flex flex-col h-full">
    <div class="relative aspect-square overflow-hidden bg-[#1a4a68]">
      <img
        src={resolveAssetUrl(post.coverImageUrl)}
        alt={post.title}
        loading="lazy"
        class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105 motion-reduce:transform-none motion-reduce:transition-none"
      />
      <div class="absolute top-3 start-3 bg-[#0f2f49] rounded px-3 py-1 shadow-md ring-1 ring-white/15">
        <Dateline date={post.date} location={post.location} lang={lang} tone="onDark" />
      </div>
    </div>
    <div class="p-6 flex flex-col flex-grow">
      <CategoryPill category={catLabel} class="mb-3 self-start" />
      <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-[#1a4a68] transition-colors line-clamp-2">
        {post.title}
      </h3>
      <p class="text-slate-500 text-sm leading-relaxed mb-4 line-clamp-3 flex-grow">
        {post.excerpt}
      </p>
      <span class="flex items-center text-[#1a4a68] font-semibold text-sm mt-auto">
        {t.common.readMore}
        <svg class="w-4 h-4 ms-1 rtl-flip transition-transform group-hover:translate-x-1 motion-reduce:transform-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </span>
    </div>
  </article>
</a>
