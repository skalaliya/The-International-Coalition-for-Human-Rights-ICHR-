---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import NewsCard from '@/components/NewsCard.astro';
import Dateline from '@/components/Dateline.astro';
import CategoryPill from '@/components/CategoryPill.astro';
import { getPublishedPosts } from '@/lib/api';
import { parsePageParam } from '@/lib/pagination';
import { resolveAssetUrl } from '@/lib/assets';
import { POST_CATEGORIES, type PostCategory } from '@/types';
import { useTranslations, localizeHref, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const url = Astro.url;
// Number('abc') is NaN and Math.max(1, NaN) is NaN — see src/lib/pagination.ts.
const page = parsePageParam(url.searchParams.get('page'));
const categoryParam = url.searchParams.get('category') ?? 'All';
const category = (POST_CATEGORIES.includes(categoryParam as PostCategory) ? categoryParam : 'All') as
  | PostCategory
  | 'All';
const PAGE_SIZE = 9;

const { items, totalPages } = await getPublishedPosts({ page, pageSize: PAGE_SIZE, category, locale: lang });

const showFeatured = page === 1 && category === 'All' && items.length > 0;
const featured = showFeatured ? items[0] : undefined;
const rest = featured ? items.slice(1) : items;

const newsBase = localizeHref('/news', lang);
const catLabel = (c: PostCategory | 'All') => (c === 'All' ? t.news.filterAll : t.categories[c] ?? c);
const filters: (PostCategory | 'All')[] = ['All', ...POST_CATEGORIES];
const filterHref = (c: string) => (c === 'All' ? newsBase : `${newsBase}?category=${encodeURIComponent(c)}`);
const pageHref = (p: number) => {
  const params = new URLSearchParams();
  if (category !== 'All') params.set('category', category);
  if (p > 1) params.set('page', String(p));
  const qs = params.toString();
  return qs ? `${newsBase}?${qs}` : newsBase;
};
const emptyMsg =
  category === 'All' ? t.news.emptyAll : t.news.emptyCategory.replace('{category}', catLabel(category));
---

<BaseLayout title={t.meta.news.title} description={t.meta.news.desc} lang={lang}>
  <header class="bg-[#1a4a68] text-white py-16 md:py-20 px-6 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm font-medium text-white/60 uppercase tracking-wider mb-4">{t.news.eyebrow}</p>
      <h1 class="text-2xl md:text-[2rem] font-bold mb-3 leading-tight">{t.news.title}</h1>
      <p class="text-base md:text-lg text-white/85 leading-relaxed max-w-2xl mx-auto">{t.news.intro}</p>
    </div>
  </header>

  <nav class="border-b border-slate-200 bg-white" aria-label={t.a11y.filterNews}>
    <div class="max-w-6xl mx-auto px-6 py-4 flex flex-wrap gap-2 justify-center" role="radiogroup">
      {filters.map((c) => (
        <a
          href={filterHref(c)}
          role="radio"
          aria-checked={category === c}
          class:list={[
            'text-sm px-4 py-2 rounded-full border transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1a4a68] focus-visible:ring-offset-2',
            category === c
              ? 'bg-[#1a4a68] text-white border-[#1a4a68]'
              : 'text-slate-600 border-slate-200 hover:border-[#1a4a68]',
          ]}
        >
          {catLabel(c)}
        </a>
      ))}
    </div>
  </nav>

  <Section width="wide" spacing="default" bg="subtle">
    {items.length === 0 ? (
      <div class="text-center py-20">
        <h2 class="text-xl font-semibold text-slate-700 mb-2">{t.news.emptyTitle}</h2>
        <p class="text-slate-500">{emptyMsg}</p>
      </div>
    ) : (
      <>
        {featured && (
          <a
            href={localizeHref(`/news/${featured.slug}`, lang)}
            class="group grid md:grid-cols-2 gap-8 items-center bg-white rounded-xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 mb-12 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1a4a68] focus-visible:ring-offset-2"
          >
            <div class="relative h-72 md:h-80 overflow-hidden bg-[#1a4a68]">
              <img
                src={resolveAssetUrl(featured.coverImageUrl)}
                alt={featured.title}
                loading="lazy"
                class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105 motion-reduce:transform-none"
              />
            </div>
            <div class="p-8">
              <Dateline date={featured.date} location={featured.location} lang={lang} class="mb-3" />
              <CategoryPill category={catLabel(featured.category)} class="mb-4" />
              <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4 group-hover:text-[#1a4a68] transition-colors line-clamp-3">
                {featured.title}
              </h2>
              <p class="text-slate-600 leading-relaxed line-clamp-3">{featured.excerpt}</p>
            </div>
          </a>
        )}

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {rest.map((post) => <NewsCard post={post} lang={lang} />)}
        </div>

        {totalPages > 1 && (
          <nav class="flex justify-center items-center gap-3 mt-14" aria-label={t.a11y.pagination}>
            {page > 1 && (
              <a href={pageHref(page - 1)} class="inline-flex items-center gap-1 px-4 py-2 rounded border border-slate-200 text-sm hover:border-[#1a4a68] transition-colors">
                <span class="rtl-flip" aria-hidden="true">←</span> {t.news.prev}
              </a>
            )}
            <span class="text-sm text-slate-500">
              {t.news.pageOf.replace('{page}', String(page)).replace('{total}', String(totalPages))}
            </span>
            {page < totalPages && (
              <a href={pageHref(page + 1)} class="inline-flex items-center gap-1 px-4 py-2 rounded border border-slate-200 text-sm hover:border-[#1a4a68] transition-colors">
                {t.news.next} <span class="rtl-flip" aria-hidden="true">→</span>
              </a>
            )}
          </nav>
        )}
      </>
    )}
  </Section>
</BaseLayout>
