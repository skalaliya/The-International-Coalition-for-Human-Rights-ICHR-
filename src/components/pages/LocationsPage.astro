---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import { WorldMap } from '@/components/react/WorldMap';
import { locations, STATS } from '@/lib/locations';
import { useTranslations, localizeHref, type Locale } from '@/i18n';
import { worldMapLabels } from '@/i18n/maplabels';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (href: string) => localizeHref(href, lang);
const mapLabels = worldMapLabels(lang);

const headOffices = locations.filter((l) => l.kind === 'hq');
const fieldOffices = locations.filter((l) => l.kind !== 'hq');
const pin = '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" />';

const ld = t.locationsData;
const offices = ld.offices as Record<string, { title: string; description: string }>;
const locTitle = (l: (typeof locations)[number]) => offices[String(l.id)]?.title ?? l.title;
const locDesc = (l: (typeof locations)[number]) => offices[String(l.id)]?.description ?? l.description;
const locCat = (l: (typeof locations)[number]) => ld.categories[l.category] ?? l.category;

const stats = [
  { n: STATS.offices, l: t.locations.stats.offices },
  { n: STATS.countries, l: t.locations.stats.countries },
  { n: STATS.continents, l: t.locations.stats.continents },
  { n: STATS.hq, l: t.locations.stats.hq },
  { n: STATS.regional, l: t.locations.stats.regional },
  { n: STATS.field, l: t.locations.stats.field },
];
---

<BaseLayout title={t.meta.locations.title} description={t.meta.locations.desc} lang={lang}>
  <PageHeader title={t.locations.title} subtitle={t.locations.subtitle} />

  <Section width="content" spacing="lg">
    <h2 class="text-xl md:text-2xl font-bold text-[#1a4a68] mb-8 text-center">{t.locations.headOffices}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {headOffices.map((office) => (
        <div class="bg-slate-50 p-6 rounded-lg border border-slate-200">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-[#1a4a68] rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={pin} />
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-slate-800 mb-1">{locTitle(office)}</h3>
              <p class="text-xs text-[#1a4a68] uppercase tracking-wider font-medium mb-3">{locCat(office)}</p>
              <p class="text-sm text-slate-600 mb-4">{locDesc(office)}</p>
              {office.address && <p class="text-sm text-slate-500 mb-2">{office.address}</p>}
              <div class="flex flex-col gap-1.5 text-sm">
                {office.email && (
                  <a href={`mailto:${office.email}`} class="text-slate-600 hover:text-[#1a4a68] transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
                    {office.email}
                  </a>
                )}
                {office.phone && (
                  <a href={`tel:${office.phone}`} class="text-slate-600 hover:text-[#1a4a68] transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z" /></svg>
                    {office.phone}
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section bg="subtle" spacing="lg" width="wide">
    <div class="text-center mb-8">
      <h2 class="text-xl md:text-2xl font-bold text-[#1a4a68] mb-3">{t.locations.regionalTitle}</h2>
      <p class="text-slate-600 max-w-2xl mx-auto text-sm">{t.locations.regionalIntro}</p>
    </div>

    <dl class="grid grid-cols-3 sm:grid-cols-6 gap-px bg-slate-200 rounded-xl overflow-hidden border border-slate-200 max-w-4xl mx-auto mb-8">
      {stats.map((s) => (
        <div class="bg-white px-2 py-4 text-center">
          <dd class="text-2xl font-bold text-[#1a4a68] tabular-nums leading-none">{s.n}</dd>
          <dt class="text-[11px] uppercase tracking-wider text-slate-500 mt-1.5">{s.l}</dt>
        </div>
      ))}
    </dl>

    <a
      href="#office-directory"
      class="sr-only focus:not-sr-only focus:block focus:mb-3 focus:text-center focus:text-sm focus:font-medium focus:text-[#1a4a68]"
    >
      {t.locations.skipMap}
    </a>

    <WorldMap client:only="react" labels={mapLabels} />

    <noscript>
      <p class="text-center text-sm text-slate-500 mt-4">{t.locations.noscript}</p>
    </noscript>
  </Section>

  {fieldOffices.length > 0 && (
    <Section width="wide" spacing="lg" id="office-directory">
      <h2 class="text-xl md:text-2xl font-bold text-[#1a4a68] mb-8 text-center">{t.locations.fieldTitle}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {fieldOffices.map((office) => (
          <div class="bg-white p-5 rounded-lg border border-slate-200 hover:border-slate-300 transition-colors">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center">
                <svg class="w-4 h-4 text-[#1a4a68]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={pin} />
              </div>
              <div>
                <h3 class="font-semibold text-slate-800 text-sm">{locTitle(office)}</h3>
                <p class="text-xs text-slate-500">{locCat(office)}</p>
              </div>
            </div>
            <p class="text-sm text-slate-600">{locDesc(office)}</p>
          </div>
        ))}
      </div>
    </Section>
  )}

  <Section bg="primary" spacing="lg">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-xl md:text-2xl font-bold text-white mb-4">{t.locations.partnerTitle}</h2>
      <p class="text-white/80 mb-6 text-sm leading-relaxed">{t.locations.partnerBody}</p>
      <a href={L('/contact')} class="inline-block px-6 py-2.5 bg-white text-[#1a4a68] font-medium rounded hover:bg-slate-100 transition-colors text-sm">{t.locations.partnerCta}</a>
    </div>
  </Section>
</BaseLayout>
