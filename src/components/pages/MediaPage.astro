---
// The /media grid. Structure and idiom follow NewsListPage.astro deliberately, so the
// two sections read as one site: same navy header band, same radiogroup filter row,
// same subtle-background card grid.
//
// No pagination: the registry is a handful of videos and the filter is a facet, not a
// route family. Add pagination here if the list ever outgrows one screen.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import VideoCard from '@/components/VideoCard.astro';
import { getVideos, PLAYLISTS, PUBLISHED_VIDEOS, type PlaylistId } from '@/data/videos';
import { SOCIAL_PROFILES } from '@/lib/site';
import { useTranslations, localizeHref, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Same shape as the news category filter: validate against the declared list, and treat
// anything else as 'All' rather than rendering an empty grid for a junk query string.
const playlistParam = Astro.url.searchParams.get('playlist') ?? 'All';
const playlist = (PLAYLISTS.includes(playlistParam as PlaylistId) ? playlistParam : 'All') as PlaylistId | 'All';

const videos = getVideos(lang, playlist);

const mediaBase = localizeHref('/media', lang);
const label = (p: PlaylistId | 'All') =>
  p === 'All' ? t.media.filterAll : (t.media.playlists as Record<string, string>)[p] ?? p;
const filters: (PlaylistId | 'All')[] = ['All', ...PLAYLISTS];
const filterHref = (p: string) => (p === 'All' ? mediaBase : `${mediaBase}?playlist=${encodeURIComponent(p)}`);

const channel = SOCIAL_PROFILES.find((s) => s.name === 'YouTube')?.href;
// Only worth a filter row when there is more than one thing to filter by — and only when
// there is anything listed at all, or an empty page would show pills above no results.
// Keyed off the whole listed set, not `videos`: a playlist that happens to be empty must
// still leave the reader a way back to "All".
const showFilters = PLAYLISTS.length > 1 && PUBLISHED_VIDEOS.length > 0;
---

<BaseLayout title={t.meta.media.title} description={t.meta.media.desc} lang={lang}>
  <header class="bg-[#1a4a68] text-white py-16 md:py-20 px-6 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm font-medium text-white/60 uppercase tracking-wider mb-4">{t.media.eyebrow}</p>
      <h1 class="text-2xl md:text-[2rem] font-bold mb-3 leading-tight">{t.media.title}</h1>
      <p class="text-base md:text-lg text-white/85 leading-relaxed max-w-2xl mx-auto">{t.media.intro}</p>
    </div>
  </header>

  {
    showFilters && (
      <nav class="border-b border-slate-200 bg-white" aria-label={t.a11y.filterVideos}>
        <div class="max-w-6xl mx-auto px-6 py-4 flex flex-wrap gap-2 justify-center" role="radiogroup">
          {filters.map((p) => (
            <a
              href={filterHref(p)}
              role="radio"
              aria-checked={playlist === p}
              class:list={[
                'text-sm px-4 min-h-[44px] inline-flex items-center rounded-full border transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1a4a68] focus-visible:ring-offset-2',
                playlist === p
                  ? 'bg-[#1a4a68] text-white border-[#1a4a68]'
                  : 'text-slate-600 border-slate-200 hover:border-[#1a4a68]',
              ]}
            >
              {label(p)}
            </a>
          ))}
        </div>
      </nav>
    )
  }

  <Section width="wide" spacing="default" bg="subtle">
    {
      videos.length === 0 ? (
        <div class="text-center py-20">
          <h2 class="text-xl font-semibold text-slate-700 mb-2">{t.media.emptyTitle}</h2>
          <p class="text-slate-500">{t.media.emptyBody}</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {videos.map((video) => (
            <VideoCard video={video} lang={lang} />
          ))}
        </div>
      )
    }

    {
      channel && (
        <p class="text-center mt-12">
          <a
            href={channel}
            rel="noopener noreferrer"
            target="_blank"
            class="inline-flex items-center min-h-[44px] px-6 rounded-full border border-slate-300 text-sm font-semibold text-[#1a4a68] hover:border-[#1a4a68] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1a4a68] focus-visible:ring-offset-2"
          >
            {t.media.watchOnYouTube}
          </a>
        </p>
      )
    }
  </Section>
</BaseLayout>
