---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Dateline from '@/components/Dateline.astro';
import CategoryPill from '@/components/CategoryPill.astro';
import type { ArticleData } from '@/server/article';
import { renderMarkdown } from '@/lib/markdown';
import { resolveAssetUrl, absoluteUrl } from '@/lib/assets';
import ShareButtons from '@/components/ShareButtons.astro';
import ShareRail from '@/components/ShareRail.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { ORG, SAME_AS, SITE_URL } from '@/lib/site';
import { useTranslations, localizeHref, LOCALES, type Locale, type Alternate } from '@/i18n';

interface Props {
  lang: Locale;
  /** Loaded by the route wrapper under src/pages, never fetched here. */
  article: ArticleData;
}
// This component renders a KNOWN-GOOD article. The missing/draft/DB-outage decision
// belongs to the route: returning a Response or setting Astro.response.status from a
// component renders into an already-sent response (ResponseSentError → a soft-200
// "Internal server error"). Keep this file free of awaits and early returns.
const { lang, article } = Astro.props;
const { post, translations } = article;
const t = useTranslations(lang);

const bodyHtml = renderMarkdown(post.body);
const coverAbs = absoluteUrl(post.coverImageUrl);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const L = (href: string) => localizeHref(href, lang);

// Published translations of this story → language toggle + hreflang alternates.
const byLocale = new Map(translations.map((tr) => [tr.locale, tr] as const));
if (!byLocale.has(lang)) byLocale.set(lang, { locale: lang, slug: post.slug, title: post.title });
const availableLocales = LOCALES.filter((l) => byLocale.has(l));
const transHrefs: Partial<Record<Locale, string>> = {};
for (const l of availableLocales) transHrefs[l] = localizeHref(`/news/${byLocale.get(l)!.slug}`, l);
const alternates: Alternate[] = availableLocales.map((l) => ({
  hreflang: l,
  href: new URL(localizeHref(`/news/${byLocale.get(l)!.slug}`, l), Astro.site ?? Astro.url).href,
}));
const enTr = byLocale.get('en');
if (enTr) {
  alternates.push({
    hreflang: 'x-default',
    href: new URL(localizeHref(`/news/${enTr.slug}`, 'en'), Astro.site ?? Astro.url).href,
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  inLanguage: lang,
  headline: post.title,
  description: post.excerpt,
  image: [coverAbs],
  datePublished: post.date,
  dateModified: post.updatedAt,
  author: { '@type': 'Organization', name: post.authorName || 'ICHR' },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: ORG.name,
    url: SITE_URL,
    logo: { '@type': 'ImageObject', url: ORG.logo },
    sameAs: SAME_AS,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};
---

<BaseLayout
  title={`${post.title} — ICHR`}
  description={post.excerpt}
  canonical={canonical}
  ogType="article"
  ogImage={coverAbs}
  jsonLd={jsonLd}
  lang={lang}
  alternates={alternates}
  localeSwitch={{ hrefs: transHrefs, available: availableLocales }}
>
  <article>
    <ShareRail url={canonical} title={post.title} lang={lang} />
    <Section width="content" spacing="sm">
      <a
        href={L('/news')}
        class="inline-flex items-center text-sm font-medium text-[#1a4a68] hover:text-[#2a6a96] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1a4a68] focus-visible:ring-offset-2 rounded"
      >
        <svg class="w-4 h-4 me-1 rtl-flip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
        {t.article.back}
      </a>
    </Section>

    <Section width="prose" spacing="none" class="pt-4">
      <Dateline date={post.date} location={post.location} lang={lang} class="mb-3" />
      <div class="mb-4"><CategoryPill category={t.categories[post.category] ?? post.category} /></div>
      <h1 class="text-3xl md:text-[2.5rem] font-bold text-slate-900 leading-tight mb-6">{post.title}</h1>
      <p class="text-lg md:text-xl text-slate-600 leading-relaxed">{post.excerpt}</p>
      {availableLocales.length > 1 && (
        <div class="mt-5 inline-flex items-center gap-2 text-sm text-slate-500">
          <span>{t.article.availableIn}:</span>
          <LanguageSwitcher lang={lang} hrefs={transHrefs} available={availableLocales} />
        </div>
      )}
      <div class="mt-6 pt-6 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center gap-4">
        {post.authorName && (
          <p class="text-sm text-slate-500"><span class="font-medium text-slate-700">{post.authorName}</span></p>
        )}
        <ShareButtons url={canonical} title={post.title} lang={lang} class="sm:ms-auto" />
      </div>
    </Section>

    {post.coverImageUrl && (
      <Section width="content" spacing="sm">
        <div class="rounded-xl overflow-hidden border border-slate-200 bg-[#1a4a68] flex justify-center">
          <img src={resolveAssetUrl(post.coverImageUrl)} alt={post.title} class="max-h-[640px] w-auto object-contain" />
        </div>
      </Section>
    )}

    <Section width="prose" spacing="default">
      <div class="prose-article" set:html={bodyHtml} />
    </Section>

    {post.gallery?.length > 0 && (
      <Section width="content" spacing="default" bg="subtle">
        <div class="flex items-center gap-3 mb-8">
          <span class="h-px w-10 bg-[color:var(--color-gold)]" aria-hidden="true"></span>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">{t.article.gallery}</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {post.gallery.map((g, i) => (
            <figure class="bg-white rounded-lg overflow-hidden border border-slate-100 shadow-sm">
              <div class="bg-[#1a4a68]">
                <img src={resolveAssetUrl(g.url)} alt={g.caption ?? `${post.title} — ${i + 1}`} loading="lazy" class="w-full aspect-[4/5] object-contain" />
              </div>
              {g.caption && <figcaption class="px-4 py-3 text-sm text-slate-500 leading-snug">{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </Section>
    )}

    {post.hashtags?.length > 0 && (
      <Section width="prose" spacing="sm">
        <ul class="flex flex-wrap gap-2" aria-label={t.a11y.tags}>
          {post.hashtags.map((tag) => (
            <li class="text-sm font-medium text-[#1a4a68] bg-[#1a4a68]/10 px-3 py-1 rounded-full">
              #{tag.replace(/^#/, '')}
            </li>
          ))}
        </ul>
      </Section>
    )}

    <Section width="prose" spacing="sm">
      <div class="rounded-xl bg-slate-50 border border-slate-100 p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">
        <div>
          <p class="text-base font-semibold text-slate-800">{t.article.shareStory}</p>
          <p class="text-sm text-slate-500">{t.article.shareHelp}</p>
        </div>
        <ShareButtons url={canonical} title={post.title} label="" lang={lang} />
      </div>
    </Section>
  </article>

  <Section bg="primary" spacing="lg">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">{t.article.supportTitle}</h2>
      <p class="text-white/80 mb-8 leading-relaxed">{t.article.supportBody}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={L('/donate')} class="px-8 py-3 bg-white text-[#1a4a68] font-medium rounded hover:bg-slate-100 transition-colors">{t.article.donate}</a>
        <a href={L('/volunteer')} class="px-8 py-3 border border-white/40 text-white font-medium rounded hover:bg-white/10 transition-colors">{t.article.volunteer}</a>
      </div>
    </div>
  </Section>
</BaseLayout>
