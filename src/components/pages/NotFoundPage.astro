---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import { useTranslations, localizeHref, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (h: string) => localizeHref(h, lang);
---

<BaseLayout title={t.meta.notFound.title} noindex={true} lang={lang}>
  <Section width="content" spacing="lg">
    <div class="text-center py-16">
      <p class="text-sm font-semibold uppercase tracking-wider text-[color:var(--color-gold)] mb-3">{t.notFound.code}</p>
      <h1 class="text-2xl md:text-3xl font-bold text-slate-800 mb-4">{t.notFound.title}</h1>
      <p class="text-slate-500 mb-8 max-w-md mx-auto">
        {t.notFound.body}
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={L('/')} class="inline-flex items-center justify-center px-6 py-3 bg-[#1a4a68] text-white font-medium rounded hover:bg-[#133549] transition-colors">
          {t.notFound.goHome}
        </a>
        <a href={L('/news')} class="inline-flex items-center justify-center px-6 py-3 border border-slate-300 text-slate-700 font-medium rounded hover:border-[#1a4a68] transition-colors">
          {t.notFound.visitNews}
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>
