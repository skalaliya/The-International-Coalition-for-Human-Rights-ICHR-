---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { useTranslations, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const input = 'w-full px-3 py-2.5 rounded border border-slate-200 focus:border-[#1a4a68] focus:outline-none text-base';
const pin = '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" />';
---

<BaseLayout title={t.meta.contact.title} description={t.meta.contact.desc} lang={lang}>
  <PageHeader title={t.contact.title} subtitle={t.contact.subtitle} />

  <Section width="wide" spacing="lg">
    <div class="flex flex-col lg:flex-row gap-12 max-w-5xl mx-auto">
      <div class="lg:w-1/3 space-y-8">
        <div>
          <h2 class="text-lg font-semibold text-[#1a4a68] mb-4">{t.contact.headOffices}</h2>
          <div class="space-y-4">
            {t.contact.offices.map((o) => (
              <div class="bg-slate-50 p-5 rounded-lg border border-slate-200">
                <div class="flex items-start gap-3">
                  <svg class="w-4 h-4 text-[#1a4a68] mt-1 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={pin} />
                  <div>
                    <h3 class="font-medium text-slate-800 text-sm">{o.city}</h3>
                    <p class="text-xs text-slate-500 mt-1">{o.role}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2 class="text-lg font-semibold text-[#1a4a68] mb-4">{t.contact.channelsTitle}</h2>
          <div class="space-y-4">
            <a href="tel:+33768851066" class="flex items-center gap-3 text-slate-600 hover:text-[#1a4a68] transition-colors">
              <div class="w-9 h-9 rounded-full bg-[#1a4a68]/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-[#1a4a68]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z" /></svg>
              </div>
              <div>
                <span class="block text-xs text-slate-500">{t.contact.general}</span>
                <span class="font-medium text-slate-800 text-sm">+33 7 68 85 10 66</span>
              </div>
            </a>
            <a href="mailto:info@ichr-international.org" class="flex items-center gap-3 text-slate-600 hover:text-[#1a4a68] transition-colors">
              <div class="w-9 h-9 rounded-full bg-[#1a4a68]/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-[#1a4a68]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
              </div>
              <div>
                <span class="block text-xs text-slate-500">{t.contact.email}</span>
                <span class="font-medium text-slate-800 text-sm">info@ichr-international.org</span>
              </div>
            </a>
            <a href="https://wa.me/41762419963" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-slate-600 hover:text-[#1a4a68] transition-colors">
              <div class="w-9 h-9 rounded-full bg-[#1a4a68]/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-[#1a4a68]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.142 1.595 5.945L0 24l6.335-1.652a12.062 12.062 0 0 0 5.71 1.448h.005c6.585 0 11.946-5.336 11.949-11.896 0-3.176-1.24-6.165-3.495-8.411" /></svg>
              </div>
              <div>
                <span class="block text-xs text-slate-500">{t.contact.whatsapp}</span>
                <span class="font-medium text-slate-800 text-sm">+41 76 241 99 63</span>
              </div>
            </a>
          </div>
        </div>

        <div>
          <h2 class="text-lg font-semibold text-[#1a4a68] mb-4">{t.contact.followTitle}</h2>
          <SocialLinks tone="light" />
        </div>
      </div>

      <div class="lg:flex-1">
        <div class="bg-white rounded-lg border border-slate-200 p-6 md:p-8">
          <h2 class="text-lg font-semibold text-slate-800 mb-1">{t.contact.formTitle}</h2>
          <p class="text-sm text-slate-500 mb-6">{t.contact.formIntro}</p>
          <form class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5" for="c-name">{t.contact.fullName}</label>
                <input id="c-name" type="text" class={input} />
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5" for="c-org">{t.contact.org}</label>
                <input id="c-org" type="text" class={input} />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5" for="c-email">{t.contact.emailAddress}</label>
                <input id="c-email" type="email" class={input} />
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5" for="c-subject">{t.contact.subject}</label>
                <select id="c-subject" class={`${input} bg-white`}>
                  {t.contact.subjects.map((s) => (
                    <option>{s}</option>
                  ))}
                </select>
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5" for="c-msg">{t.contact.message}</label>
              <textarea id="c-msg" rows={5} class={`${input} resize-none`}></textarea>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-500 bg-slate-50 p-3 rounded">
              <svg class="w-3.5 h-3.5 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z" /></svg>
              <p>{t.contact.privacy}</p>
            </div>
            <button type="button" class="w-full bg-[#1a4a68] hover:bg-[#133549] text-white font-medium py-3 rounded transition-colors text-sm">
              {t.contact.send}
            </button>
          </form>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
