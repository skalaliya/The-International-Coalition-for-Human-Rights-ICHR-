---
interface Props {
  width?: 'prose' | 'content' | 'wide' | 'full';
  spacing?: 'sm' | 'default' | 'lg' | 'none';
  bg?: 'white' | 'subtle' | 'primary';
  id?: string;
  class?: string;
}

const { width = 'wide', spacing = 'default', bg = 'white', id, class: className = '' } = Astro.props;

const widthClasses = {
  prose: 'max-w-[680px]',
  content: 'max-w-[960px]',
  wide: 'max-w-6xl',
  full: 'max-w-full',
};
const spacingClasses = {
  none: 'py-0',
  sm: 'py-8 md:py-12',
  default: 'py-12 md:py-20',
  lg: 'py-16 md:py-24',
};
const bgClasses = {
  white: 'bg-white',
  subtle: 'bg-slate-50',
  primary: 'bg-[#1a4a68] text-white',
};
---

<section id={id} class={`px-6 md:px-8 ${spacingClasses[spacing]} ${bgClasses[bg]} ${className}`}>
  <div class={`mx-auto ${widthClasses[width]}`}>
    <slot />
  </div>
</section>
