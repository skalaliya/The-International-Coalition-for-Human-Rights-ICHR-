---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
}
const { title, subtitle, eyebrow } = Astro.props;
---

<header class="bg-[#1a4a68] text-white py-16 md:py-20 px-6 text-center">
  <div class="max-w-3xl mx-auto">
    {eyebrow && (
      <p class="text-sm font-medium text-white/60 uppercase tracking-wider mb-4">{eyebrow}</p>
    )}
    <h1 class="text-2xl md:text-[2rem] font-bold mb-3 leading-tight">{title}</h1>
    {subtitle && (
      <p class="text-base md:text-lg text-white/85 leading-relaxed max-w-2xl mx-auto">{subtitle}</p>
    )}
  </div>
</header>
