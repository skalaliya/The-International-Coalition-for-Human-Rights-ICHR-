---
// Institutional hero — calm, confident, restrained CTA.
---

<section class="relative bg-[#1a4a68] text-white overflow-hidden">
  <div class="absolute inset-0">
    <img
      src="/images/hero-advocacy.jpg"
      alt=""
      class="w-full h-full object-cover opacity-20"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#1a4a68]/80 to-[#1a4a68]"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-6 py-24 md:py-32 text-center">
    <p class="text-sm font-medium text-white/60 uppercase tracking-wider mb-6">
      International Non-Governmental Organisation
    </p>
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-6">
      The International Coalition<br class="hidden md:block" /> for Human Rights
    </h1>
    <p class="text-lg md:text-xl text-white/85 leading-relaxed max-w-2xl mx-auto mb-10">
      Coordinating civil society efforts, documenting violations, and providing
      humanitarian response to protect human dignity worldwide.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/about"
        class="px-8 py-3 bg-white text-[#1a4a68] font-medium rounded hover:bg-slate-100 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a4a68]"
      >
        Our Mandate
      </a>
      <a
        href="/locations"
        class="px-8 py-3 border border-white/40 text-white font-medium rounded hover:bg-white/10 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a4a68]"
      >
        Global Presence
      </a>
    </div>
  </div>
</section>
