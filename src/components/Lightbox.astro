---
// Full-screen viewer for gallery images.
//
// WHY: press statements are published as photographs of designed cards and, for formal
// submissions, as page scans. Measured on a 375px phone, an A4 page inside the gallery
// grid renders about 287px wide — legible as a thumbnail, unreadable as a document. A
// reader on a phone had no way to enlarge it and had to hunt for the PDF link.
//
// Progressive enhancement, deliberately: the markup below is inert without JavaScript and
// the grid keeps working exactly as before. Everything here is additive.
//
// Uses <dialog> for the top layer, focus trapping and Esc handling that the platform
// already implements correctly — no library, no focus-management code of our own to get
// wrong, and it inherits the page's `dir`, so it is right for Arabic without extra work.
interface Props {
  /** Localized labels — this component is rendered inside all three locales. */
  closeLabel: string;
  hint: string;
}
const { closeLabel, hint } = Astro.props;
---

<dialog
  id="lightbox"
  class="backdrop:bg-black/80 bg-transparent p-0 m-0 max-w-none max-h-none w-full h-full"
  aria-label={hint}
>
  <div class="relative w-full h-full flex flex-col">
    <button
      id="lightbox-close"
      type="button"
      class="absolute top-3 end-3 z-10 inline-flex items-center justify-center min-w-[44px] min-h-[44px] rounded-full bg-black/60 text-white text-2xl leading-none hover:bg-black/80 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
      aria-label={closeLabel}
    >
      <span aria-hidden="true">&times;</span>
    </button>

    <!-- The image is sized by the browser; pinch-zoom works because the dialog does not
         trap touch gestures and the img is a plain, unscaled element. -->
    <img id="lightbox-img" src="" alt="" class="flex-1 min-h-0 w-full object-contain p-2" />

    <p id="lightbox-caption" class="shrink-0 text-center text-sm text-white/90 px-6 pb-6 pt-2 max-w-3xl mx-auto"></p>
  </div>
</dialog>

<script>
  (() => {
    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const caption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');
    // Nothing to enhance on a page with no gallery.
    const figures = document.querySelectorAll<HTMLElement>('[data-lightbox]');
    if (!dialog || !img || !caption || !figures.length || typeof dialog.showModal !== 'function') return;

    const open = (source: HTMLImageElement, text: string) => {
      // Always load the ORIGINAL, not whatever small variant the grid picked — the whole
      // point of opening it is to read the page.
      img.src = source.getAttribute('data-full') || source.currentSrc || source.src;
      img.alt = source.alt;
      caption.textContent = text;
      caption.hidden = !text;
      dialog.showModal();
    };

    figures.forEach((fig) => {
      const source = fig.querySelector('img');
      if (!source) return;
      const text = fig.querySelector('figcaption')?.textContent?.trim() ?? '';

      // The trigger is a real button so it is keyboard-reachable and announced, rather
      // than a click handler bolted onto an image.
      const trigger = fig.querySelector<HTMLButtonElement>('[data-lightbox-open]');
      trigger?.addEventListener('click', () => open(source, text));
    });

    closeBtn?.addEventListener('click', () => dialog.close());
    // Clicking the backdrop closes it, which is what everyone expects from a lightbox.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    // Free the (potentially multi-megabyte) original once it is out of view.
    dialog.addEventListener('close', () => {
      img.src = '';
    });
  })();
</script>
