---
import { LOCALES, LANG_NAMES, localizedPath, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
  /** Explicit per-locale hrefs (article pages pass existing-translations-only). */
  hrefs?: Partial<Record<Locale, string>>;
  /** Which locales to offer (default: all). Article pages restrict to existing. */
  available?: readonly Locale[];
  class?: string;
}

const { lang, hrefs, available = LOCALES, class: className = '' } = Astro.props;
const path = Astro.url.pathname;
const search = Astro.url.search;

function hrefFor(l: Locale): string {
  if (hrefs && hrefs[l]) return hrefs[l]!;
  return localizedPath(path, l) + search;
}
---

<div class={`flex items-center gap-2 ${className}`}>
  {/* Globe glyph — universally signals "choose your language". */}
  <svg
    class="w-4 h-4 shrink-0 text-slate-400"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="9" />
    <path d="M3 12h18" />
    <path d="M12 3c2.5 2.5 3.8 5.7 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3Z" />
  </svg>

  {/* Segmented control: the active language reads as a raised "thumb". */}
  <div
    class="inline-flex items-center gap-0.5 rounded-full bg-slate-100/90 p-0.5 ring-1 ring-slate-200/70"
    role="group"
    aria-label="Change language"
  >
    {
      available.map((l) => (
        <a
          href={hrefFor(l)}
          hreflang={l}
          lang={l}
          dir={l === 'ar' ? 'rtl' : 'ltr'}
          aria-current={l === lang ? 'true' : undefined}
          title={LANG_NAMES[l]}
          class:list={[
            'px-2.5 py-1 text-[13px] leading-none font-medium rounded-full whitespace-nowrap transition-all duration-200 ease-out focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1a4a68] focus-visible:ring-offset-1 focus-visible:ring-offset-white',
            l === lang
              ? 'bg-white text-[#1a4a68] font-semibold shadow-sm'
              : 'text-slate-500 hover:text-[#1a4a68] hover:bg-white/60',
          ]}
        >
          {LANG_NAMES[l]}
        </a>
      ))
    }
  </div>
</div>
