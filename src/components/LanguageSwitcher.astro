---
import { LOCALES, LANG_NAMES, localizedPath, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
  /** Explicit per-locale hrefs (article pages pass existing-translations-only). */
  hrefs?: Partial<Record<Locale, string>>;
  /** Which locales to offer (default: all). Article pages restrict to existing. */
  available?: readonly Locale[];
  /** 'bar' = compact desktop nav; 'panel' = full-width, touch-sized mobile menu. */
  variant?: 'bar' | 'panel';
  class?: string;
}

const { lang, hrefs, available = LOCALES, variant = 'bar', class: className = '' } = Astro.props;
const path = Astro.url.pathname;
const search = Astro.url.search;
const panel = variant === 'panel';

function hrefFor(l: Locale): string {
  if (hrefs && hrefs[l]) return hrefs[l]!;
  return localizedPath(path, l) + search;
}
---

<div class:list={['flex items-center gap-2', panel && 'w-full', className]}>
  {/* Globe glyph — universally signals "choose your language". */}
  <svg
    class:list={['shrink-0 text-slate-400', panel ? 'w-5 h-5' : 'w-4 h-4']}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="9" />
    <path d="M3 12h18" />
    <path d="M12 3c2.5 2.5 3.8 5.7 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3Z" />
  </svg>

  {/* Segmented control: the active language reads as a raised "thumb".
      On mobile (panel) it fills the row and each segment is a 44px touch target. */}
  <div
    class:list={[
      'inline-flex items-center rounded-full bg-slate-100/90 ring-1 ring-slate-200/70',
      panel ? 'flex-1 gap-1 p-1' : 'gap-0.5 p-0.5',
    ]}
    role="group"
    aria-label="Change language"
  >
    {
      available.map((l) => (
        <a
          href={hrefFor(l)}
          hreflang={l}
          lang={l}
          dir={l === 'ar' ? 'rtl' : 'ltr'}
          aria-current={l === lang ? 'true' : undefined}
          title={LANG_NAMES[l]}
          class:list={[
            'leading-none rounded-full whitespace-nowrap transition-all duration-200 ease-out focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1a4a68] focus-visible:ring-offset-1 focus-visible:ring-offset-white',
            panel
              ? 'flex-1 min-h-[44px] flex items-center justify-center text-center px-3 text-sm'
              : 'px-2.5 py-1 text-[13px]',
            l === lang
              ? 'bg-white text-[#1a4a68] font-semibold shadow-sm'
              : 'text-slate-500 hover:text-[#1a4a68] hover:bg-white/60 font-medium',
          ]}
        >
          {LANG_NAMES[l]}
        </a>
      ))
    }
  </div>
</div>
