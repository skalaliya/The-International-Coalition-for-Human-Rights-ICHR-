---
import SocialLinks from '@/components/SocialLinks.astro';
import { useTranslations, localizeHref, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const L = (href: string) => localizeHref(href, lang);

const links = [
  { label: t.nav.about, href: '/about' },
  { label: t.nav.locations, href: '/locations' },
  { label: t.nav.news, href: '/news' },
  { label: t.nav.contact, href: '/contact' },
];
---

<footer class="bg-slate-900 text-slate-300">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <img src="/logo.png" alt="ICHR" class="h-10 w-auto bg-white rounded p-1" />
          <span class="text-lg font-semibold text-white">ICHR</span>
        </div>
        <p class="text-sm leading-relaxed text-slate-400 mb-6">{t.footer.blurb}</p>
        <SocialLinks tone="dark" />
      </div>

      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-6">{t.footer.headOffices}</h4>
        <div class="space-y-5 text-sm">
          {t.contact.offices.map((o) => (
            <div class="flex gap-3">
              <svg class="w-4 h-4 text-slate-500 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
              <div>
                <div class="text-white font-medium mb-1">{o.city}</div>
                <div class="text-slate-400">{o.role}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-6">{t.footer.contact}</h4>
        <div class="space-y-4 text-sm">
          <a href="mailto:info@ichr-international.org" class="flex items-center gap-3 text-slate-400 hover:text-white transition-colors">
            <svg class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
            info@ichr-international.org
          </a>
          <a href="tel:+33768851066" class="flex items-center gap-3 text-slate-400 hover:text-white transition-colors">
            <svg class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z" /></svg>
            +33 7 68 85 10 66
          </a>
          <a href="https://wa.me/41762419963" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-slate-400 hover:text-white transition-colors">
            <svg class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.142 1.595 5.945L0 24l6.335-1.652a12.062 12.062 0 0 0 5.71 1.448h.005c6.585 0 11.946-5.336 11.949-11.896 0-3.176-1.24-6.165-3.495-8.411" /></svg>
            <span>+41 76 241 99 63 <span class="text-slate-500">· {t.contact.whatsapp}</span></span>
          </a>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-800">
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
            {links.map((item) => (
              <a href={L(item.href)} class="text-slate-400 hover:text-white transition-colors">{item.label}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-slate-800">
    <div class="max-w-6xl mx-auto px-6 pt-6 pb-[calc(1.5rem_+_env(safe-area-inset-bottom))]">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
        <p>© {year} {t.footer.orgName}. {t.footer.rights}</p>
        <div class="flex items-center gap-6">
          <span class="text-slate-600">{t.footer.privacy}</span>
          <span class="text-slate-600">{t.footer.terms}</span>
        </div>
      </div>
    </div>
  </div>
</footer>
