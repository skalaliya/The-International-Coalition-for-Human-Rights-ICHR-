---
// Inline share row so readers can post the article to social platforms.
import { shareLinks } from '@/lib/share';

interface Props {
  url: string; // absolute canonical URL of the article
  title: string;
  label?: string;
  class?: string;
}
const { url, title, label = 'Share', class: className = '' } = Astro.props;
const shares = shareLinks(url, title);

const cls =
  'w-10 h-10 rounded-full flex items-center justify-center bg-slate-100 text-slate-600 hover:bg-[#1a4a68] hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1a4a68] focus-visible:ring-offset-2';
---

<div class={`flex items-center gap-3 flex-wrap ${className}`}>
  {label && (
    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">{label}</span>
  )}
  <div class="flex items-center gap-2">
    {shares.map((s) => (
      <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`Share on ${s.name}`} class={cls}>
        <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={s.path} />
        </svg>
      </a>
    ))}
    <button type="button" class={`share-copy ${cls}`} data-url={url} aria-label="Copy link" title="Copy link">
      <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    if (window.__ichrShareInit) return;
    window.__ichrShareInit = true;
    function flash(btn) {
      btn.classList.add('!bg-green-600', '!text-white');
      setTimeout(function () { btn.classList.remove('!bg-green-600', '!text-white'); }, 1300);
    }
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.share-copy');
      if (!btn) return;
      var url = btn.getAttribute('data-url');
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function () { flash(btn); }).catch(function () {});
      } else {
        var ta = document.createElement('textarea');
        ta.value = url; document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); } catch (err) {}
        document.body.removeChild(ta); flash(btn);
      }
    });
  })();
</script>
