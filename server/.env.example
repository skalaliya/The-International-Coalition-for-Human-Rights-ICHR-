# Prisma datasource (path is relative to prisma/schema.prisma → server/prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Auth — use a long random string in production
JWT_SECRET="change_me_to_a_long_random_string"

# Admin bootstrap (used by prisma/seed.js)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"

# Server
PORT=3001

# Optional: override the upload directory (defaults to server/uploads)
# UPLOAD_DIR="./uploads"
